# Negocio
NEXT_PUBLIC_WHATSAPP_NUMBER=59899999999  # sin "+" ni espacios. Ej: 59899123456
NEXT_PUBLIC_SITE_URL=https://laclavija.com.uy  # dominio de prod (canonical, OG, sitemap dependen de esto)

# SEO — opcional, pegá acá el token que te da Google Search Console cuando verifiques el sitio
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Web Analytics — opcional. Sacá el "token" de dash.cloudflare.com → Analytics & Logs → Web Analytics → Add a site
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                 # pública, va al frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # SECRETA — sólo server-side (seed, server actions admin)
