/**
 * Config del Worker de Cloudflare para deploy vía Pages/Workers.
 * Este proyecto se despliega con `pnpm cf:deploy` (ver package.json).
 *
 * IMPORTANTE — routes y vars viven ACÁ, no en el dashboard.
 *   - `wrangler deploy` pisa las routes y vars del dashboard con lo que dice
 *     este archivo. Si algo se maneja desde el dashboard se pierde al deploy.
 *   - Los `secrets` (SUPABASE_SERVICE_ROLE_KEY) SÍ viven en el dashboard porque
 *     wrangler nunca los pisa (por diseño). Ver Settings → Variables and secrets.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laclavija",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // Deshabilitar el subdominio workers.dev auto-generado.
  // Solo el custom domain (laclavija.com.uy) sirve trafico — evita duplicado
  // que Google podria indexar como sitio aparte y penalizar SEO.
  "workers_dev": false,
  "preview_urls": false,

  // Custom domains — mapean el Worker a laclavija.com.uy y www.
  "routes": [
    {
      "pattern": "laclavija.com.uy",
      "zone_name": "laclavija.com.uy",
      "custom_domain": true
    },
    {
      "pattern": "www.laclavija.com.uy",
      "zone_name": "laclavija.com.uy",
      "custom_domain": true
    }
  ],

  // Variables públicas — se inyectan al Worker en runtime.
  // (Las mismas están en el dashboard build settings para que Next las
  // bakee en el bundle a build time. Duplicación intencional.)
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://laclavija.com.uy",
    "NEXT_PUBLIC_WHATSAPP_NUMBER": "59898125667",
    "NEXT_PUBLIC_SUPABASE_URL": "https://dqvcjdzmtomkjsufmffp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRxdmNqZHptdG9ta2pzdWZtZmZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4MDA4NDUsImV4cCI6MjA5NTM3Njg0NX0.RCzBfVt0oA-QM5lKnmrzQo0jOEHB-CX9xswnrXJp8LM"
  },

  // KV namespace para el incremental cache de Next.js. Guarda paginas SSG
  // pre-renderizadas y las revalida on-demand. Reemplaza al staticAssets
  // read-only anterior — permite que revalidatePath() funcione desde
  // server actions (cargar guitarra desde admin → home se actualiza sola).
  // Free tier: 100k reads/dia, mas que suficiente.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "3c5fed458678464489402be70e9cce4c"
    }
  ]
}
